# All paths default to this checkout, NOT /tmp. Never commit secrets or disks.
SKVM_PORT=31120
SKVM_HOST=0.0.0.0
# Optional. Otherwise generated in data/.session-key with permissions 0600.
# SKVM_SECRET_KEY=generate-a-long-random-secret
SKVM_COOKIE_SECURE=0
# Set 1 when using HTTPS (including Codespaces). HTTP local development needs 0.
# Default admin / admin123 is created once on a NEW empty panel; change it on first login.
# Set 0 BEFORE first startup to disable it and use create-admin instead.
SKVM_BOOTSTRAP_ADMIN=1
SKVM_TEST_MODE=0
SKVM_ENABLE_QEMU=1
SKVM_ENABLE_DOCKER=1
# Real managed-QEMU WebSSH. Requires HTTPS except on localhost.
# Update remote agents/proxies too; see docs/webssh.md.
SKVM_WEBSSH_ENABLED=1
# Never requires KVM. Explicit opt-in AND a real accelerator probe are required.
SKVM_USE_KVM=0
# Only set after verifying storage-driver quota prerequisites on your Docker host.
SKVM_DOCKER_STORAGE_LIMITS=0
# Optional LOCAL Unix daemon; use the matching path for your rootless setup.
# DOCKER_HOST=unix:///run/user/1000/docker.sock
# TCP/SSH Docker transports are refused, even with TLS: deploy SKVM agent on that host.
# Never expose or forward a Docker socket to the browser.
# Exact allowlist for external nodes. TLS certificates must validate.
SKVM_NODE_HOSTS=
# Optional CA file for a private node CA; verification is NEVER disabled.
# SKVM_NODE_CA_BUNDLE=/secure/path/to/node-ca.pem
# Required on external agents only. Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# SKVM_NODE_TOKEN=
# SKVM_DATA_DIR=/workspaces/ZVM/data
# SKVM_DATABASE_URL=sqlite:////workspaces/ZVM/database/skvm.db
