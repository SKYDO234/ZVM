{
  "name": "SKVM \u00b7 QEMU + Docker control plane",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [
    31120
  ],
  "portsAttributes": {
    "31120": {
      "label": "SKVM Panel",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },
  "postCreateCommand": "bash install.sh --no-start",
  "remoteEnv": {
    "SKVM_COOKIE_SECURE": "1"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  },
  "postStartCommand": ".venv/bin/python scripts/serve-panel.py --background"
}
