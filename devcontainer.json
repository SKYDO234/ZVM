{
  "name": "SKVM · QEMU + Docker control plane",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [5555],
  "portsAttributes": {"5555": {"label": "SKVM Panel", "onAutoForward": "notify", "protocol": "http"}},
  "postCreateCommand": "bash scripts/install-codespaces.sh",
  "remoteEnv": {"SKVM_COOKIE_SECURE": "1"},
  "customizations": {"vscode": {"settings": {"python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"}}}
}
